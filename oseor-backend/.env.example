# OSEOR backend - copy to .env and fill in
DB_URL=jdbc:postgresql://localhost:5432/oseor_db
DB_USERNAME=postgres
DB_PASSWORD=
# Generated automatically by run-backend.ps1 when empty
JWT_SECRET=
# Optional: SMTP account used to email contact-form messages
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Info@oseor.tg
# HTTP port of the API (8080 by default)
SERVER_PORT=8081
