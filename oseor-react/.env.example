# URL de l'API backend (Projet-OSEOR-Backend, Spring Boot).
# En développement, laisser /api : Vite relaie les appels vers http://localhost:8080.
VITE_API_URL=/api

# Bon Plan API (central "Bons Plans & ZenCard" content). Unset = local content only.
# The key is the site's publishable key (pk_…) from the Bon Plan admin.
VITE_BONPLAN_API_URL=
VITE_BONPLAN_KEY=
VITE_BONPLAN_SITE=oseor
