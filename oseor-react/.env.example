# URL de l'API backend (Projet-OSEOR-Backend, Spring Boot).
# En développement, laisser /api : Vite relaie les appels vers http://localhost:8080.
VITE_API_URL=/api

# Bon Plan API: the connection link from the Bon Plan admin (Sites → this site → Connexion du site).
# Empty = this site keeps its own local content.
VITE_BONPLAN_URL=
