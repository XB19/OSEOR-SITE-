# Configuration Docker — copier ce fichier en .env et le compléter (.env n'est jamais publié)

# Mot de passe de la base PostgreSQL créée par Docker
DB_USERNAME=postgres
DB_PASSWORD=

# Clé de signature des sessions admin (au moins 32 caractères aléatoires)
# Exemple pour en générer une :  openssl rand -base64 48
JWT_SECRET=

# Port du site sur la machine hôte
SITE_PORT=3000

# Optionnel : compte SMTP pour recevoir les messages de contact par e-mail
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Info@oseor.tg
